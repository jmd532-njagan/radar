// RADAR's own Prisma schema, targeting the "radar" Postgres schema inside the same
// database WatchTower's own "public" schema lives in (one physical Postgres instance,
// two independently-migrated schemas — same pattern as the pre-existing "freshdesk"
// schema, just under Prisma's own migration tooling instead of raw SQL).
//
// Moved here from watch-Tower/prisma/radar/ (2026-08-04) — this repo is deployed as its
// own separate service now, so it owns its own schema/migration history directly rather
// than depending on watch-Tower's repo to run `prisma migrate` on its behalf. Nothing
// under src/ queries through this generated client — radar's own SQLAlchemy models stay
// the plain ORM definitions this backend actually runs against; this schema exists to
// own DDL/migrations only, matching table/column names exactly so no query code changes.
// The backend's own Alembic migrations are retired (see migrations.retired/RETIRED.md) in
// favor of this being the one authoritative migration history.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/radar-client"
}

datasource db {
  provider = "postgresql"
  url      = env("RADAR_SCHEMA_DATABASE_URL")
}

model ProjectMetadata {
  project  String  @id
  platform String?

  failurePatterns   FailurePattern[]
  memory            ProjectMemory[]
  sopDocuments      SopDocument[]
  failureEvents     FailureEvent[]
  chatThreads       ChatThread[]

  @@map("project_metadata")
}

// Row-Level Security enabled + FORCEd, policy scoped by `platform` — hand-added raw SQL in the
// 20260804000002 migration (Prisma's schema DSL has no RLS/CREATE POLICY construct, same
// reason ChatThread.claimed_by_user_id's cross-schema FK is hand-added rather than modeled
// here). See that migration's comment for why it currently has zero practical effect (the app
// connects as a Postgres superuser, which unconditionally bypasses RLS) until the app's DB
// role is changed to a non-superuser one.
model RBACPermission {
  platform         String  @default("adf")
  tool_name        String
  allowed          Boolean
  requires_consent Boolean @default(true)

  @@id([platform, tool_name])
  @@map("rbac_permissions")
}

// One row per kind of failure in a project. `identity` is the parsed signature's specific code
// or, for generic wrapper codes, its fingerprint (see src/intake/signature.py); null for
// symptom-only patterns extracted from SOPs. Occurrences are failure_events rows pointing here.
// CHECKs and the FK to public."User" are hand-added in the migrations (Prisma can't model them).
// An uploaded SOP; a new upload replaces the project's previous one (status 'replaced').
// At most one active per project: partial unique index uq_sop_documents_one_active, hand-added
// in the migration (Prisma can't model partial indexes).
model SopDocument {
  id           BigInt   @id @default(autoincrement())
  project      String
  file_name    String
  content_hash String
  version      Int
  status       String   @default("active")
  warnings     Json     @default("[]")
  uploaded_by  String?  @db.Uuid
  uploaded_at  DateTime @default(now()) @db.Timestamptz

  projectMetadata ProjectMetadata @relation(fields: [project], references: [project])
  chunks          SopChunk[]

  @@index([project, status], map: "ix_sop_documents_project_status")
  @@map("sop_documents")
}

// One retrievable section of an SOP with its bge-base embedding; scored in memory (no index).
model SopChunk {
  id           BigInt   @id @default(autoincrement())
  document_id  BigInt
  position     Int
  heading_path String
  text         String
  embedding    Float[]  @db.Real

  document SopDocument      @relation(fields: [document_id], references: [id], onDelete: Cascade)
  facts    ProjectMemory[]
  patterns FailurePattern[]

  @@index([document_id], map: "ix_sop_chunks_document")
  @@map("sop_chunks")
}

// Short facts about a project, always included in the agent's system prompt. kind: environment
// | schedule | dependency | contact | rule | quirk | verify_after. origin: human | incident | sop.
// status: proposed | active | retired.
model ProjectMemory {
  id          BigInt    @id @default(autoincrement())
  project     String
  kind        String
  text        String
  origin      String
  status      String    @default("proposed")
  created_by  String?   @db.Uuid
  approved_by String?   @db.Uuid
  approved_at DateTime? @db.Timestamptz
  source_chunk_id BigInt?
  created_at  DateTime  @default(now()) @db.Timestamptz
  updated_at  DateTime  @default(now()) @db.Timestamptz

  projectMetadata ProjectMetadata @relation(fields: [project], references: [project])
  sourceChunk     SopChunk?       @relation(fields: [source_chunk_id], references: [id], onDelete: SetNull)

  @@index([project, status], map: "ix_project_memory_project_status")
  @@map("project_memory")
}

model FailurePattern {
  id          BigInt    @id @default(autoincrement())
  project     String
  status      String    @default("proposed")
  identity    String?
  platform    String
  code        String?
  error_type  String?
  template    String?
  pipelines   String[]  @default([])
  category    String?
  cause       String?
  verify_with String[]  @default([])
  fix_actions String[]  @default([])
  approved_by String?   @db.Uuid
  approved_at DateTime? @db.Timestamptz
  source_chunk_id BigInt?
  created_at  DateTime  @default(now()) @db.Timestamptz
  updated_at  DateTime  @default(now()) @db.Timestamptz

  projectMetadata ProjectMetadata @relation(fields: [project], references: [project])
  sourceChunk     SopChunk?       @relation(fields: [source_chunk_id], references: [id], onDelete: SetNull)
  failureEvents   FailureEvent[]

  @@unique([project, identity], name: "uq_failure_patterns_project_identity")
  @@map("failure_patterns")
}

model AuditLog {
  audit_id         BigInt   @id @default(autoincrement())
  investigation_id String?
  // Nullable — not every audited event happens inside a chat thread (e.g. thread_setup's
  // "notification_ready" fires at intake, and this column wasn't backfilled for pre-existing
  // rows, see the migration). Not modeled as a Prisma relation into ChatThread on purpose —
  // the FK itself is hand-added as raw SQL in the migration (same reasoning as
  // RBACPermission's RLS policy elsewhere in this file: Prisma's relation DSL doesn't need to
  // model every FK for the raw SQL to be real and enforced).
  thread_id        String?  @db.Uuid
  pipeline_name    String
  project          String
  platform         String
  timestamp        DateTime @db.Timestamptz
  event_type       String
  // WatchTower's public."User".id — never an email. Nullable: system-originated events
  // (intake, the diagnosis pipeline) have no real user to attribute to.
  user_id          String?  @db.Uuid
  detail           Json?

  failureEvent FailureEvent? @relation(fields: [investigation_id], references: [investigation_id])

  @@index([investigation_id])
  @@index([thread_id])
  @@map("audit_log")
}

model FailureEvent {
  investigation_id String   @id
  project          String
  platform         String
  pipeline_name    String
  factory_name     String?
  run_status       String
  start_time       DateTime @db.Timestamptz
  end_time         DateTime? @db.Timestamptz
  last_error       String?
  error_detail     Json?
  trigger_type     String?
  seed_message     String?
  seen_at          DateTime? @db.Timestamptz
  pattern_id       BigInt?
  matched_by       String?
  outcome          String?
  signature        Json?
  created_at       DateTime @db.Timestamptz
  updated_at       DateTime? @db.Timestamptz

  projectMetadata ProjectMetadata @relation(fields: [project], references: [project])
  pattern         FailurePattern? @relation(fields: [pattern_id], references: [id], onDelete: SetNull)
  auditLogs       AuditLog[]
  chatThread      ChatThread?     @relation("FailureEventThread")

  @@index([project, pipeline_name, created_at], name: "ix_failure_events_project_pipeline_created")
  @@index([pattern_id], map: "ix_failure_events_pattern")
  @@map("failure_events")
}

model ChatThread {
  thread_id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project                       String
  investigation_id              String?   @unique
  title                         String?
  claimed_by_user_id            String?   @db.Uuid
  is_deleted                    Boolean   @default(false)
  context_summary               String?
  summarized_through_timestamp  DateTime? @db.Timestamptz
  pending_tool_approval         Json?
  created_at                    DateTime  @db.Timestamptz
  updated_at                    DateTime? @db.Timestamptz

  projectMetadata ProjectMetadata @relation(fields: [project], references: [project])
  failureEvent    FailureEvent?   @relation("FailureEventThread", fields: [investigation_id], references: [investigation_id])
  messages        ChatMessage[]
  analytics       ChatAnalytics[]

  @@index([project])
  @@index([claimed_by_user_id])
  @@map("chat_threads")
}

model ChatMessage {
  id         BigInt   @id @default(autoincrement())
  thread_id  String   @db.Uuid
  role       String
  content    String
  tool_calls Json?
  created_at DateTime @db.Timestamptz

  chatThread ChatThread @relation(fields: [thread_id], references: [thread_id])
  feedback   MessageFeedback[]

  @@index([thread_id, created_at], name: "ix_chat_messages_thread_created")
  @@map("chat_messages")
}

// purpose's CHECK (chat | sop_extraction | memory_plan | summary | title) is in the migration.
model ChatAnalytics {
  id              BigInt   @id @default(autoincrement())
  thread_id       String?  @db.Uuid
  purpose         String   @default("chat")
  user_id         String?  @db.Uuid
  project         String
  platform        String
  model           String
  input_tokens    Int      @default(0)
  output_tokens   Int      @default(0)
  cached_tokens   Int      @default(0)
  estimated_cost  Float    @default(0.0)
  created_at      DateTime @db.Timestamptz

  chatThread ChatThread? @relation(fields: [thread_id], references: [thread_id])

  @@index([thread_id])
  @@index([user_id])
  @@map("chat_analytics")
}

// user_id's FK to public."User" is hand-added in the migration (cross-schema).
model MessageFeedback {
  id         BigInt   @id @default(autoincrement())
  message_id BigInt
  user_id    String   @db.Uuid
  rating     String
  created_at DateTime @db.Timestamptz
  updated_at DateTime? @db.Timestamptz

  message ChatMessage @relation(fields: [message_id], references: [id])

  @@unique([message_id, user_id], name: "uq_message_feedback_message_user")
  @@map("message_feedback")
}

