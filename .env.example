# Copy to .env and fill in real values. Never commit the real .env.
# Only secrets and per-deployment addresses live here; fixed values are in src/config/settings.py.
# Every value is required: the app refuses to start without it.

# --- Azure OpenAI (Azure AI Foundry) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-gpt-4o-deployment-name
AZURE_OPENAI_API_KEY=

# --- WatchTower's Postgres ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/watchtower
# The same database in Prisma's format, for `npx prisma migrate deploy` only (not read by the app).
RADAR_SCHEMA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/watchtower?schema=radar

# --- Shared with WatchTower (each must match WatchTower's own value) ---
# Signs POST /events/pipeline-failure.
HMAC_SECRET=
# WatchTower's RADAR_ASSERTION_SECRET: verifies the user behind each chat call.
RADAR_ASSERTION_SECRET=
# WatchTower's JWT_SECRET_KEY: decrypts each project's ADF client secret.
WATCHTOWER_CREDENTIAL_KEY=

# "production" disables /docs, /redoc and /openapi.json. Optional; defaults to development.
ENVIRONMENT=development
